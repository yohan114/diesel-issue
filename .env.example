# ---- Fleet Fuel Management :: environment template ----
# Copy to .env and fill real values. NEVER commit the real .env.
# (A leaked GitHub token prompted this app — keep ALL secrets out of git.)

# SQLite database (path is relative to the prisma/ directory)
DATABASE_URL="file:../data/app.db"

# Auth: 32+ byte random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Shared secret protecting the cron route handlers (price refresh / backup)
CRON_SECRET="replace-with-a-random-string"

# Seeded default admin (used once by `npm run seed`). Change after first login.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Administrator"

# Scheduler (in-process node-cron). Set ENABLE_SCHEDULER=false to disable.
ENABLE_SCHEDULER="true"
# Monthly price refresh (1st @ 06:00) and daily backup (02:30) — cron syntax
PRICE_REFRESH_CRON="0 6 1 * *"
BACKUP_CRON="30 2 * * *"
BACKUP_RETENTION_DAYS="7"
